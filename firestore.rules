rules_version = '2';

// ============================================================
//  중앙대학교 인문대학 학생회 페이지 — Firestore 보안 규칙
// ------------------------------------------------------------
//  ⚠ 이 파일을 반드시 배포해야 합니다. 배포하지 않으면 기본
//    테스트 규칙(30일 뒤 전체 차단 또는 전체 허용)이 적용되어
//    제출 내용이 누구에게나 보이거나 아예 동작하지 않습니다.
//
//  배포 방법 (Firebase 콘솔)
//    Firestore Database → 규칙 탭 → 이 파일 내용을 붙여넣고 게시
//
//  관리자 지정
//    Firestore 에 admins 컬렉션을 만들고, 문서 ID 를 관리자 계정의
//    UID 로 하는 빈 문서를 추가하세요.
//    (UID 는 Authentication → 사용자 탭에서 확인)
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 폼이 지금 접수 가능한 상태인지
    //  open == true 이고, openAt 이 지났고, closeAt 이 아직 안 지났을 것
    //  (openAt / closeAt 은 없어도 되며, 없으면 그 방향으로는 제한이 없다)
    function formIsOpen(f) {
      return f.open == true
             && (!('openAt'  in f) || f.openAt  == null || f.openAt  <= request.time)
             && (!('closeAt' in f) || f.closeAt == null || f.closeAt >  request.time);
    }

    // 로그인한 관리자인지 확인
    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---- 관리자 명단 : 본인 것만 읽기, 쓰기는 콘솔에서만 ----
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- 링크 모음 : 누구나 읽기, 관리자만 수정 ----
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- 공지 ----
    //  · 예약 공지(publishAt 이 아직 안 지난 것)는 서버에서 막는다.
    //    화면에서 숨기는 것만으로는 Firestore 를 직접 조회하면 보이므로,
    //    발표 전 내용이 새지 않도록 규칙에서 차단한다.
    //  · 보관(지난) 공지는 계속 읽을 수 있다 — 아카이브 페이지에서 쓴다.
    //
    //  ※ 이 조건 때문에 공개 페이지는 반드시
    //       where('publishAt', '<=', now)
    //    를 붙여 조회해야 한다. (js/store.js 가 그렇게 한다)
    //    필터 없이 조회하면 Firestore 가 쿼리 전체를 거부한다.
    match /notices/{noticeId} {
      allow read: if isAdmin()
                  || (resource.data.publishAt is timestamp
                      && resource.data.publishAt <= request.time);
      allow write: if isAdmin();
    }

    // ---- 폼 정의 : 누구나 읽기, 관리자만 수정 ----
    //  접수 기간 자체는 숨길 이유가 없으므로 공개한다.
    //  (실제 접수 차단은 아래 submissions 규칙이 담당)
    match /forms/{formId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- 폼 제출 ----
    //  · 제출(create)은 누구나 가능하되 형식을 검증한다
    //  · 읽기/수정/삭제는 관리자만  ← 이름·학번 등이 담기므로 매우 중요
    match /submissions/{docId} {
      allow read, update, delete: if isAdmin();

      allow create: if
           // 보낼 수 있는 필드는 이 셋뿐
           request.resource.data.keys().hasOnly(['formId', 'data', 'createdAt'])
        && request.resource.data.formId is string
        && request.resource.data.formId.size() > 0
        && request.resource.data.formId.size() <= 64
        && request.resource.data.data is map
        // 항목 수 제한 (폼 필드가 아무리 많아도 30개면 충분)
        && request.resource.data.data.size() <= 30
        // 시각은 서버 시각만 허용 — 임의 조작 방지
        && request.resource.data.createdAt == request.time
        // 해당 폼이 실제로 존재하고, 열려 있으며, 접수 기간 안일 때만 받는다.
        // 화면에서 막는 것과 별개로 서버에서도 반드시 막아야 한다.
        && exists(/databases/$(database)/documents/forms/$(request.resource.data.formId))
        && formIsOpen(get(/databases/$(database)/documents/forms/$(request.resource.data.formId)).data);
    }

    // 그 밖의 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

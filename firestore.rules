rules_version = '2';

// ============================================================
//  중앙대학교 인문대학 학생회 페이지 — Firestore 보안 규칙
// ------------------------------------------------------------
//  ⚠ 이 파일을 반드시 배포해야 합니다. 배포하지 않으면 기본
//    테스트 규칙(30일 뒤 전체 차단 또는 전체 허용)이 적용되어
//    제출 내용이 누구에게나 보이거나 아예 동작하지 않습니다.
//
//  배포 방법 (Firebase 콘솔)
//    Firestore Database → 규칙 탭 → 이 파일 내용을 붙여넣고 게시
//
//  관리자 지정
//    Firestore 에 admins 컬렉션을 만들고, 문서 ID 를 관리자 계정의
//    UID 로 하는 빈 문서를 추가하세요.
//    (UID 는 Authentication → 사용자 탭에서 확인)
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 폼이 지금 접수 가능한 상태인지
    //  기간이 둘이다. 게시 기간(publishAt~expireAt)은 폼이 사이트에 보이는
    //  기간이고, 접수 기간(openAt~closeAt)은 응답을 받는 기간이다.
    //  게시 중이 아니면 접수도 받지 않는다 — 화면과 같은 규칙을 서버에도 건다.
    //  (네 시각 모두 없어도 되며, 없으면 그 방향으로는 제한이 없다)
    //
    //  이 함수는 목록 조회가 아니라 get() 으로 읽은 문서 하나를 보므로,
    //  공지에서 문제가 됐던 '목록 조회에서 resource.data 참조 불가' 제약에
    //  걸리지 않는다. 그래서 폼은 서버에서도 시각을 따질 수 있다.
    function formIsOpen(f) {
      return f.open == true
             && (!('archived'  in f) || f.archived  != true)
             && (!('publishAt' in f) || f.publishAt == null || f.publishAt <= request.time)
             && (!('expireAt'  in f) || f.expireAt  == null || f.expireAt  >  request.time)
             && (!('openAt'    in f) || f.openAt    == null || f.openAt    <= request.time)
             && (!('closeAt'   in f) || f.closeAt   == null || f.closeAt   >  request.time);
    }

    // 로그인한 관리자인지 확인
    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---- 관리자 명단 : 본인 것만 읽기, 쓰기는 콘솔에서만 ----
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- 링크 모음 : 누구나 읽기, 관리자만 수정 ----
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- 공지 : 누구나 읽기, 관리자만 수정 ----
    //
    //  예약 공지를 서버에서까지 가리려고 publishAt <= request.time 조건을
    //  걸었었지만, 그러면 목록 조회 자체가 거부된다. Firestore 는 목록
    //  조회에서 'resource.data 를 참조하는 조건' 을 클라이언트 질의가
    //  보장하는지 따지는데, 클라이언트가 보낸 시각이 서버의 request.time
    //  이하임을 증명할 방법이 없기 때문이다. (실제로 permission-denied)
    //
    //  서버에서 도는 스케줄러가 없는 이상 '정해진 시각에 자동 공개' 와
    //  '공개 전 서버 차단' 을 동시에 만족시킬 수 없다. 누군가는 그 시각에
    //  값을 바꿔줘야 하는데 정적 사이트에는 그럴 주체가 없다.
    //  자동 공개 쪽을 택했다. 예약 공지는 화면에서 가려지지만 Firestore 를
    //  직접 조회하면 보일 수 있으므로, 공개 전에 새면 곤란한 내용은
    //  예약해두지 말고 때가 되었을 때 작성해 올리세요.
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- 폼 정의 : 누구나 읽기, 관리자만 수정 ----
    //  접수 기간 자체는 숨길 이유가 없으므로 공개한다.
    //  (실제 접수 차단은 아래 submissions 규칙이 담당)
    match /forms/{formId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- 폼 제출 ----
    //  · 제출(create)은 누구나 가능하되 형식을 검증한다
    //  · 읽기/수정/삭제는 관리자만  ← 이름·학번 등이 담기므로 매우 중요
    match /submissions/{docId} {
      allow read, update, delete: if isAdmin();

      allow create: if
           // 보낼 수 있는 필드는 이 셋뿐
           request.resource.data.keys().hasOnly(['formId', 'data', 'createdAt'])
        && request.resource.data.formId is string
        && request.resource.data.formId.size() > 0
        && request.resource.data.formId.size() <= 64
        && request.resource.data.data is map
        // 항목 수 제한 (폼 필드가 아무리 많아도 30개면 충분)
        && request.resource.data.data.size() <= 30
        // 시각은 서버 시각만 허용 — 임의 조작 방지
        && request.resource.data.createdAt == request.time
        // 해당 폼이 실제로 존재하고, 열려 있으며, 접수 기간 안일 때만 받는다.
        // 화면에서 막는 것과 별개로 서버에서도 반드시 막아야 한다.
        && exists(/databases/$(database)/documents/forms/$(request.resource.data.formId))
        && formIsOpen(get(/databases/$(database)/documents/forms/$(request.resource.data.formId)).data);
    }

    // ---- 열람실 좌석 ----
    //  seats 는 좌석표에 그대로 실리므로 누구나 읽는다. 대신 담기는 것은
    //  가린 이름(홍*동)과 학번 앞 5자리뿐이다. 실명 · 학과 · 전체 학번은
    //  logs 에 따로 넣고 관리자만 읽는다. 좌석표를 공개하면서 개인정보를
    //  지키려면 애초에 공개되는 문서에 그것을 담지 않는 수밖에 없다.
    //
    //  update 를 막아두는 것이 핵심이다. Firestore 는 문서가 이미 있으면
    //  set() 을 update 로 보므로, 같은 순간에 두 사람이 같은 자리를 눌러도
    //  뒤에 도착한 쪽은 서버가 거부한다. 화면 검사만으로는 못 막는다.
    //
    //  날짜는 문서 경로에 들어 있어, 날이 바뀌면 좌석표가 저절로 비워진다.
    //  따로 초기화해줄 서버가 없어도 되도록 이렇게 짰다.
    //  (화면은 18시가 지나면 그날 좌석표를 비워 보여준다)

    // 지금이 개방 시간(한국 08~18시)인지.
    //  UTC 에 9시간을 더해 서울 자정으로부터 흐른 밀리초를 구한다.
    //  08시 = 28800000, 18시 = 64800000 밀리초.
    //  한국은 서머타임이 없어 언제나 +9 로 맞다.
    //  toMillis 와 나머지 연산만 쓴다 — 규칙 게시가 거부될 여지를 줄이려는 것이다.
    function kstMillisOfDay() {
      return (request.time.toMillis() + 32400000) % 86400000;
    }
    function inOpenHours() {
      return kstMillisOfDay() >= 28800000 && kstMillisOfDay() < 64800000;
    }

    //  {day} 가 오늘인지까지는 서버에서 따지지 않는다. 개방 시간이 UTC 날짜를
    //  넘나들게 되면서(한국 08시 = 전날 UTC 23시) 규칙 안에서 서울 날짜를
    //  안전하게 만들 방법이 마땅치 않아졌다. 그 검사는 위생 문제일 뿐이고
    //  (엉뚱한 날짜에 쓴 문서는 화면에 뜨지 않고 관리자가 지우면 된다),
    //  중요한 것 — 덮어쓰기 금지, 명단 비공개, 비우기 본인 확인 — 은 그대로다.
    function seatOk(seatNo, d) {
      return inOpenHours()
             && d.seat is int && d.seat >= 1 && d.seat <= 60
             && string(d.seat) == seatNo
             && d.createdAt == request.time;
    }

    match /seatdays/{day}/seats/{seatNo} {
      allow read: if true;
      allow create: if seatOk(seatNo, request.resource.data)
        && request.resource.data.keys().hasOnly(['seat', 'nameMasked', 'sidHead', 'createdAt'])
        && request.resource.data.nameMasked is string
        && request.resource.data.nameMasked.size() <= 20
        && request.resource.data.sidHead is string
        && request.resource.data.sidHead.size() <= 5;
      allow update: if false;          // 잡힌 자리는 아무도 덮어쓸 수 없다
      allow delete: if isAdmin() || releasedAfterBooking(day, seatNo);
    }

    match /seatdays/{day}/logs/{seatNo} {
      allow read, update: if isAdmin();
      // 자리를 비우면 명단에서도 지워야 그 자리를 다시 예약할 수 있다
      allow delete: if isAdmin() || releasedAfterBooking(day, seatNo);
      allow create: if seatOk(seatNo, request.resource.data)
        && request.resource.data.keys().hasOnly(['seat', 'name', 'dept', 'sid', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.dept is string && request.resource.data.dept.size() <= 40
        && request.resource.data.sid  is string && request.resource.data.sid.size()  <= 12;
    }

    // ---- 자리 비우기 기록 (반납 · 취소) ----
    //  누가 언제 어떻게 비웠는지가 담기므로 관리자만 읽는다.
    //  쓰기는 누구나 할 수 있지만, 그 자리에 실제로 예약이 있고 이름 · 학과 ·
    //  학번이 예약 때와 똑같아야만 통과한다.
    match /seatdays/{day}/releases/{seatNo} {
      allow read, delete: if isAdmin();
      allow create, update: if inOpenHours()
        && request.resource.data.keys().hasOnly(['seat', 'name', 'dept', 'sid', 'kind', 'createdAt'])
        && request.resource.data.seat is int
        && string(request.resource.data.seat) == seatNo
        && (request.resource.data.kind == 'return' || request.resource.data.kind == 'cancel')
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/seatdays/$(day)/seats/$(seatNo))
        && matchesBooking(day, seatNo, request.resource.data);
    }

    // 그 밖의 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
